# ───────────────────────────────────────────────
# 로컬 개발용 예시. 이 파일을 .env 로 복사해서 값을 채우세요.
# 운영(Netlify)에서는 Site configuration → Environment variables 에 같은 이름으로 넣습니다.
# .env 파일은 절대 GitHub에 올리지 마세요(.gitignore 에 포함됨).
# ───────────────────────────────────────────────

# 관리자 로그인 ID
ADMIN_ID=sudol

# 관리자 비밀번호의 bcrypt 해시. 직접 비밀번호를 넣지 말고
#   npm run hash-password
# 로 만든 "b64:..." 값을 그대로 붙여넣으세요.
# (b64: 형식은 해시 안의 $ 기호가 환경변수 치환으로 깨지는 문제를 피하기 위한 것입니다)
ADMIN_PASSWORD_HASH=

# 세션 쿠키 서명 키(32바이트 이상 무작위 문자열).  npm run gen-secret 로 생성
SESSION_SECRET=

# (선택) 사이트 대표 주소. 비워두면 Netlify가 주는 URL(기본 도메인/연결한 도메인)을 사용
# SITE_URL=https://sudol.example.com

# (선택) 저장소 드라이버. 기본값: 로컬 개발 = fs(.data 폴더), 배포 = netlify(Blobs)
# STORAGE_DRIVER=fs
