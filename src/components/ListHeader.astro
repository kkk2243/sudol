---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  count?: number;
}
const { eyebrow, title, description, count } = Astro.props;
---

<header class="container-wide pb-8 pt-10 md:pb-12 md:pt-16">
  {eyebrow && <p class="text-sm font-bold text-accent-ink">{eyebrow}</p>}
  <h1 class="mt-1 text-3xl font-extrabold tracking-tight md:text-[2.5rem]">{title}</h1>
  {description && <p class="mt-3 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-2">{description}</p>}
  {typeof count === 'number' && <p class="mt-3 text-sm text-ink-3">글 {count}개</p>}
  <slot />
</header>
