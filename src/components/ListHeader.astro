---
/**
 * 페이지 머리: 검은 알약 라벨 → 큰 제목(줄바꿈 가능) → 회색 부제 → (선택) 아래 슬롯
 * 첫 화면에서 줄마다 순서대로 올라오는 효과(.intro)
 */
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  count?: number;
  /** 'h1' 기본. 홈처럼 다른 h1 이 있으면 'p' */
  as?: 'h1' | 'p';
}
const { eyebrow, title, description, count, as = 'h1' } = Astro.props;
const T = as;
---

<header class="wrap pb-10 pt-14 md:pb-14 md:pt-24">
  <div class="intro">
    {eyebrow && <p class="eyebrow">{eyebrow}</p>}
    <T class="mt-5 max-w-3xl whitespace-pre-line text-[2rem] font-bold leading-[1.28] tracking-[-0.04em] md:text-[2.875rem]">{title}</T>
    {description && <p class="mt-4 max-w-2xl whitespace-pre-line text-[0.975rem] leading-relaxed text-ink-3 md:text-base">{description}</p>}
    {typeof count === 'number' && <p class="mt-2 text-sm font-medium text-ink-3">글 {count}개</p>}
  </div>
  <slot />
</header>
