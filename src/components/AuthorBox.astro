---
import type { Settings } from '../lib/types';
import Img from './Img.astro';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
---

<section aria-label="작성자 소개" class="flex items-center gap-5 rounded-[1.5rem] border border-line p-5 md:p-6" data-reveal>
  <div class="h-16 w-16 shrink-0 overflow-hidden rounded-full bg-soft">
    {
      settings.profileImage ? (
        <Img src={settings.profileImage} alt={`${settings.authorName} 프로필 사진`} sizes="64px" class="h-full w-full object-cover" />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-3xl" aria-hidden="true">🐻</div>
      )
    }
  </div>
  <div class="min-w-0 flex-1">
    <p class="text-xs font-bold text-ink-3">WRITTEN BY</p>
    <p class="mt-0.5 text-lg font-bold tracking-tight">{settings.authorName}</p>
    <p class="mt-1 line-clamp-2 text-sm leading-relaxed text-ink-3">{settings.description}</p>
  </div>
  <a href="/about" class="hidden shrink-0 sm:inline-flex btn btn-sm btn-pill">소개 보기</a>
</section>
