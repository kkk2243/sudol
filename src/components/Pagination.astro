---
interface Props {
  page: number;
  total: number;
  /** 페이지 번호를 받아 URL을 만드는 기준 경로 (쿼리 제외) */
  basePath: string;
  /** 유지할 다른 쿼리(검색어 등) */
  extra?: Record<string, string>;
}
const { page, total, basePath, extra = {} } = Astro.props;
const href = (n: number) => {
  const q = new URLSearchParams(extra);
  if (n > 1) q.set('page', String(n));
  const s = q.toString();
  return s ? `${basePath}?${s}` : basePath;
};
const nums: (number | '…')[] = [];
for (let i = 1; i <= total; i++) {
  if (i === 1 || i === total || Math.abs(i - page) <= 1) nums.push(i);
  else if (nums[nums.length - 1] !== '…') nums.push('…');
}
---

{
  total > 1 && (
    <nav aria-label="페이지 이동" class="mt-14 flex items-center justify-center gap-1">
      {page > 1 ? (
        <a class="btn btn-sm" href={href(page - 1)} rel="prev">
          ← 이전
        </a>
      ) : (
        <span class="btn btn-sm opacity-40" aria-disabled="true">← 이전</span>
      )}
      <ul class="flex items-center gap-1 px-2">
        {nums.map((n) =>
          n === '…' ? (
            <li class="px-1 text-ink-3" aria-hidden="true">…</li>
          ) : (
            <li>
              <a
                href={href(n)}
                aria-current={n === page ? 'page' : undefined}
                class:list={[
                  'inline-flex h-9 min-w-9 items-center justify-center rounded-lg px-2 text-sm font-semibold',
                  n === page ? 'bg-accent text-on-accent' : 'text-ink-2 hover:bg-soft',
                ]}
              >
                {n}
              </a>
            </li>
          ),
        )}
      </ul>
      {page < total ? (
        <a class="btn btn-sm" href={href(page + 1)} rel="next">
          다음 →
        </a>
      ) : (
        <span class="btn btn-sm opacity-40" aria-disabled="true">다음 →</span>
      )}
    </nav>
  )
}
