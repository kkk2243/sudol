---
import type { TocItem } from '../lib/markdown/render';
interface Props {
  toc: TocItem[];
  variant: 'inline' | 'sidebar';
}
const { toc, variant } = Astro.props;
---

{
  variant === 'inline' ? (
    <details class="group mb-10 rounded-2xl bg-soft px-5 py-4 2xl:hidden">
      <summary class="flex cursor-pointer list-none items-center justify-between font-bold">
        목차
        <span class="text-ink-3 transition-transform group-open:rotate-180" aria-hidden="true">
          ▾
        </span>
      </summary>
      <ol class="mt-3 space-y-2 text-[0.95rem]">
        {toc.map((t) => (
          <li class:list={[t.depth === 3 && 'pl-4']}>
            <a href={`#${t.id}`} class="text-ink-2 hover:text-accent-ink">
              {t.text}
            </a>
          </li>
        ))}
      </ol>
    </details>
  ) : (
    <nav aria-label="목차" class="text-sm">
      <p class="mb-4 text-xs font-bold tracking-wider text-ink-3">CONTENTS</p>
      <ol class="space-y-2.5 border-l-2 border-line">
        {toc.map((t) => (
          <li class:list={['-ml-0.5 border-l-2 border-transparent pl-4 transition-colors hover:border-accent', t.depth === 3 && 'pl-7']}>
            <a href={`#${t.id}`} class="block leading-snug text-ink-2 hover:text-ink">
              {t.text}
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}
