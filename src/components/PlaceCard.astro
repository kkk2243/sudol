---
import type { PlaceInfo } from '../lib/types';
import { formatDateKo, isAllowedMapUrl, mapProviderLabel } from '../lib/util';

interface Props {
  place: PlaceInfo;
}
const { place } = Astro.props;
const rating = place.rating ? Math.min(5, Math.max(1, Math.round(place.rating))) : 0;
const mapOk = place.mapUrl && isAllowedMapUrl(place.mapUrl);
const rows: [string, string][] = [];
if (place.region) rows.push(['지역', place.region]);
if (place.address) rows.push(['주소', place.address]);
if (place.priceRange) rows.push(['가격대', place.priceRange]);
if (place.visitedAt) rows.push(['방문일', formatDateKo(place.visitedAt + 'T12:00:00+09:00')]);
---

<section aria-labelledby="place-title" class="my-14 overflow-hidden rounded-[1.5rem] bg-soft" data-reveal>
  <div class="flex items-start justify-between gap-4 p-6 md:p-8">
    <div class="min-w-0">
      <p class="eyebrow">장소 정보</p>
      <h2 id="place-title" class="mt-4 text-2xl font-bold tracking-[-0.03em]">{place.name || '방문한 곳'}</h2>
    </div>
    {
      rating > 0 && (
        <div class="shrink-0 rounded-2xl bg-surface px-4 py-3 text-center" aria-label={`별점 5점 만점에 ${rating}점`}>
          <p class="text-2xl font-black leading-none">
            {rating}
            <span class="text-sm font-semibold text-ink-3">/5</span>
          </p>
          <p class="mt-1.5 text-sm tracking-tight text-accent" aria-hidden="true">
            {'★'.repeat(rating)}
            <span class="text-line">{'★'.repeat(5 - rating)}</span>
          </p>
        </div>
      )
    }
  </div>
  {
    rows.length > 0 && (
      <dl class="grid gap-px bg-line sm:grid-cols-2">
        {rows.map(([k, v], i) => (
          <div class:list={['bg-soft px-6 py-4 md:px-8', rows.length % 2 === 1 && i === rows.length - 1 && 'sm:col-span-2']}>
            <dt class="text-xs font-semibold text-ink-3">{k}</dt>
            <dd class="mt-1 font-medium">{v}</dd>
          </div>
        ))}
      </dl>
    )
  }
  <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-5 md:px-8">
    <p class="text-xs text-ink-3">가격·영업시간은 방문 당시 기준이라 바뀔 수 있어요.</p>
    {
      mapOk && (
        <a href={place.mapUrl} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-primary btn-pill btn-sm">
          {mapProviderLabel(place.mapUrl!)} <span aria-hidden="true">↗</span>
          <span class="sr-only">(새 창)</span>
        </a>
      )
    }
  </div>
</section>
