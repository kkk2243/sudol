---
import type { PlaceInfo } from '../lib/types';
import { formatDateKo, isAllowedMapUrl, mapProviderLabel } from '../lib/util';

interface Props {
  place: PlaceInfo;
}
const { place } = Astro.props;
const rating = place.rating ? Math.min(5, Math.max(1, Math.round(place.rating))) : 0;
const mapOk = place.mapUrl && isAllowedMapUrl(place.mapUrl);
const rows: [string, string][] = [];
if (place.region) rows.push(['지역', place.region]);
if (place.address) rows.push(['주소', place.address]);
if (place.priceRange) rows.push(['가격대', place.priceRange]);
if (place.visitedAt) rows.push(['방문일', formatDateKo(place.visitedAt + 'T12:00:00+09:00')]);
---

<section aria-labelledby="place-title" class="my-10 rounded-2xl border border-line bg-surface p-5 md:p-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <p class="text-xs font-bold tracking-wider text-accent-ink">📍 장소 정보</p>
      <h2 id="place-title" class="mt-1 text-xl font-bold">{place.name || '방문한 곳'}</h2>
    </div>
    {
      rating > 0 && (
        <p class="shrink-0 text-right" aria-label={`별점 5점 만점에 ${rating}점`}>
          <span class="text-lg tracking-tight text-amber-500" aria-hidden="true">
            {'★'.repeat(rating)}
            <span class="text-line">{'★'.repeat(5 - rating)}</span>
          </span>
          <span class="block text-xs text-ink-3">{rating} / 5</span>
        </p>
      )
    }
  </div>
  {
    rows.length > 0 && (
      <dl class="mt-4 grid grid-cols-[4.5rem_1fr] gap-x-3 gap-y-2 text-[0.9375rem]">
        {rows.map(([k, v]) => (
          <>
            <dt class="text-ink-3">{k}</dt>
            <dd class="text-ink">{v}</dd>
          </>
        ))}
      </dl>
    )
  }
  {
    mapOk && (
      <a href={place.mapUrl} target="_blank" rel="noopener noreferrer nofollow" class="btn btn-sm mt-5">
        🗺️ {mapProviderLabel(place.mapUrl!)}
        <span class="sr-only">(새 창)</span>
      </a>
    )
  }
  <p class="mt-4 text-xs text-ink-3">가격·영업시간 등은 방문 당시 기준이며 바뀔 수 있어요.</p>
</section>
