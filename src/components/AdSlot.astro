---
/**
 * 애드센스 광고 자리. 기본은 아무것도 출력하지 않음.
 * 관리자 설정에 클라이언트 ID(ca-pub-...)와 해당 위치의 슬롯 ID가 모두 있을 때만 활성화.
 * 높이를 고정해서 광고가 늦게 로드돼도 본문이 밀리지 않게(CLS 방지) 합니다.
 */
import type { Settings } from '../lib/types';

interface Props {
  settings: Settings;
  position: 'top' | 'middle' | 'bottom' | 'sidebar';
}
const { settings, position } = Astro.props;
const client = settings.adsenseClient;
const slot = settings.adSlots?.[position] ?? '';
const on = /^ca-pub-\d{10,20}$/.test(client) && /^\d{6,20}$/.test(slot);
const sidebar = position === 'sidebar';
const style = sidebar ? 'display:inline-block;width:300px;height:600px' : 'display:block;width:100%;height:250px';
---

{
  on && (
    <aside class:list={['ad-slot', { 'is-sidebar': sidebar }]} aria-label="광고">
      <span class="ad-slot-label">광고</span>
      <ins class="adsbygoogle" style={style} data-ad-client={client} data-ad-slot={slot} />
      <script is:inline>
        (window.adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </aside>
  )
}
