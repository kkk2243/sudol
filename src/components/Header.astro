---
import type { MenuItem, Settings } from '../lib/types';
import Logo from './Logo.astro';

interface Props {
  settings: Settings;
  activePath: string;
}
const { settings, activePath } = Astro.props;
const isActive = (m: MenuItem) => {
  if (!m.href.startsWith('/') || m.href === '/') return activePath === m.href;
  const p = decodeURIComponent(activePath);
  return p === m.href || p.startsWith(m.href + '/');
};
const ext = (m: MenuItem) => (m.newTab || /^https?:/.test(m.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
const cta = settings.headerCta?.label ? settings.headerCta : null;
---

<header class="site-header" data-site-header>
  <div class="wrap-wide flex h-16 items-center gap-4 md:h-[84px]">
    <a href="/" class="mr-auto text-[1.375rem] md:text-[1.6rem]" aria-label={`${settings.title} 홈으로`}>
      <Logo text={settings.logoText} />
    </a>

    <nav aria-label="주 메뉴" class="hidden md:block">
      <ul class="flex items-center gap-6 lg:gap-8">
        {
          settings.menuHeader.map((m) => (
            <li>
              <a href={m.href} class="nav-link" aria-current={isActive(m) ? 'page' : undefined} {...ext(m)}>
                {m.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="flex items-center gap-1 md:ml-4 md:gap-2">
      {
        cta && (
          <a href={cta.href} class="hidden rounded-lg bg-soft px-4 py-2.5 text-sm font-semibold text-ink-2 transition-colors hover:bg-ink hover:text-bg md:inline-flex" {...ext(cta)}>
            {cta.label}
          </a>
        )
      }
      <span class="mx-1 hidden h-5 w-px bg-line md:block" aria-hidden="true"></span>
      <a href="/search" class="icon-btn" aria-label="검색">
        <svg width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="다크 모드 전환">
        <svg class="dark:hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
        <svg class="hidden dark:block" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      </button>
      <button type="button" class="icon-btn md:hidden" popovertarget="mobile-menu" aria-label="메뉴 열기" aria-controls="mobile-menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h10"></path></svg>
      </button>
    </div>
  </div>
</header>

<!-- 모바일 전체 화면 메뉴 (브라우저 기본 popover, JS 불필요) -->
<div id="mobile-menu" popover class="mobile-menu" aria-label="메뉴">
  <div class="flex h-full flex-col">
    <div class="wrap-wide flex h-16 items-center justify-between">
      <a href="/" class="text-[1.375rem]"><Logo text={settings.logoText} /></a>
      <button type="button" class="icon-btn" popovertarget="mobile-menu" popovertargetaction="hide" aria-label="메뉴 닫기">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
      </button>
    </div>
    <nav aria-label="모바일 메뉴" class="wrap-wide mt-6 flex-1 overflow-y-auto">
      <ul class="space-y-1">
        {
          settings.menuHeader.map((m) => (
            <li>
              <a href={m.href} class="flex items-center justify-between border-b border-line py-5 text-[1.75rem] font-bold tracking-tight" aria-current={isActive(m) ? 'page' : undefined} {...ext(m)}>
                {m.label}
                <span class="text-ink-3" aria-hidden="true">→</span>
              </a>
            </li>
          ))
        }
      </ul>
      {
        cta && (
          <a href={cta.href} class="btn btn-primary btn-pill mt-8 w-full" {...ext(cta)}>
            {cta.label}
          </a>
        )
      }
    </nav>
  </div>
</div>
