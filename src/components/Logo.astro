---
/** 글자 로고: 마지막 '.' 앞뒤를 나눠 점에 포인트 컬러를 줍니다. 예) 수돌이.log */
interface Props {
  text: string;
  class?: string;
}
const { text, class: cls } = Astro.props;
const i = text.lastIndexOf('.');
const head = i > 0 ? text.slice(0, i) : text;
const tail = i > 0 ? text.slice(i + 1) : '';
---

<span class:list={['inline-flex items-baseline font-black tracking-[-0.04em]', cls]}>
  {head}{i > 0 && <span class="text-accent">.</span>}{tail}
</span>
