---
import Img from './Img.astro';
import type { Category, PostSummary } from '../lib/types';
import { formatDateDot } from '../lib/util';

interface Props {
  post: PostSummary;
  category?: Category;
  headingLevel?: 'h2' | 'h3';
}
const { post, category, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---

<article class="group relative flex flex-col">
  <div class="relative aspect-[3/2] overflow-hidden rounded-2xl bg-soft">
    {
      post.cover?.src ? (
        <Img
          src={post.cover.src}
          alt={post.cover.alt || ''}
          sizes="(min-width: 1024px) 360px, (min-width: 640px) 50vw, 100vw"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        <div class="flex h-full w-full items-center justify-center text-5xl" aria-hidden="true">
          {category?.emoji ?? '📝'}
        </div>
      )
    }
  </div>
  <div class="mt-4 flex flex-1 flex-col">
    <p class="flex flex-wrap items-center gap-2 text-[0.8125rem] font-semibold text-accent-ink">
      {category && <span>{category.name}</span>}
      {post.placeRegion && <span class="font-medium text-ink-3">· {post.placeRegion}</span>}
      {post.sample && <span class="badge-sample">샘플</span>}
    </p>
    <H class="mt-1.5 text-[1.1rem] font-bold leading-snug tracking-tight">
      <a href={`/post/${post.slug}`} class="line-clamp-2 after:absolute after:inset-0 group-hover:underline group-hover:decoration-1 group-hover:underline-offset-4">
        {post.title}
      </a>
    </H>
    <p class="line-clamp-2 mt-2 text-[0.9375rem] leading-relaxed text-ink-2">{post.excerpt}</p>
    <p class="mt-3 text-[0.8125rem] text-ink-3">
      <time datetime={post.publishedAt}>{formatDateDot(post.publishedAt)}</time>
      <span aria-hidden="true"> · </span>{post.readingMinutes}분 읽기
    </p>
  </div>
</article>
