---
/**
 * 정사각 사진 카드: 사진 위 왼쪽에 카테고리, 오른쪽에 날짜, 아래에 흰 제목 상자.
 * 화면에 들어올 때 사진이 확대된 상태에서 제자리로 돌아오며 떠오릅니다.
 */
import Img from './Img.astro';
import type { Category, PostSummary } from '../lib/types';
import { formatDateDot } from '../lib/util';

interface Props {
  post: PostSummary;
  category?: Category;
  headingLevel?: 'h2' | 'h3';
  /** 그리드 안 순서(등장 시차용) */
  index?: number;
  /** 첫 화면에 보이는 카드면 true */
  eager?: boolean;
}
const { post, category, headingLevel = 'h3', index = 0, eager = false } = Astro.props;
const H = headingLevel;
// 사진이 없을 때 쓸 그라데이션(글마다 고정된 색)
let h = 0;
for (const c of post.id) h = (h * 31 + c.charCodeAt(0)) % 360;
const fallback = `background:linear-gradient(135deg,hsl(${h} 90% 72%),hsl(${(h + 50) % 360} 85% 52%))`;
const delay = `--d:${(index % 3) * 110}ms`;
---

<article class="tile" data-reveal data-tile-id={post.id} style={delay}>
  <a href={`/post/${post.slug}`} class="tile-link group">
    <div class="tile-zoom">
      {
        post.cover?.src ? (
          <Img
            src={post.cover.src}
            alt={post.cover.alt || ''}
            priority={eager && index === 0}
            sizes="(min-width: 1080px) 340px, (min-width: 640px) 50vw, 100vw"
          />
        ) : (
          <div class="tile-fallback flex items-center justify-center text-7xl" style={fallback} aria-hidden="true">
            {category?.emoji ?? '📝'}
          </div>
        )
      }
    </div>
    <div class="tile-shade" aria-hidden="true"></div>
    <div class="tile-meta">
      <span class="flex min-w-0 items-center gap-1.5 truncate">
        {category?.name ?? ''}
        {post.placeRegion && <span class="truncate font-medium opacity-85">· {post.placeRegion}</span>}
        {post.sample && <span class="badge-sample">샘플</span>}
      </span>
      <time datetime={post.publishedAt} class="shrink-0 font-medium opacity-90">{formatDateDot(post.publishedAt)}</time>
    </div>
    <div class="tile-box">
      <H class="line-clamp-2 flex-1 text-[0.9375rem] font-semibold leading-snug tracking-[-0.02em]">{post.title}</H>
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 6 6 6-6 6"></path></svg>
    </div>
  </a>
</article>
