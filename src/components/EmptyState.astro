---
interface Props {
  title: string;
  text?: string;
  emoji?: string;
  actionHref?: string;
  actionLabel?: string;
}
const { title, text, emoji = '🍽️', actionHref, actionLabel } = Astro.props;
---

<div class="rounded-[1.75rem] bg-soft px-6 py-20 text-center">
  <p class="text-5xl" aria-hidden="true">{emoji}</p>
  <p class="mt-5 text-xl font-bold tracking-tight">{title}</p>
  {text && <p class="mx-auto mt-2 max-w-md text-[0.95rem] leading-relaxed text-ink-3">{text}</p>}
  {actionHref && <a href={actionHref} class="btn btn-primary btn-pill mt-7">{actionLabel}</a>}
  <slot />
</div>
