---
interface Props {
  title: string;
  text?: string;
  emoji?: string;
  actionHref?: string;
  actionLabel?: string;
}
const { title, text, emoji = '🍽️', actionHref, actionLabel } = Astro.props;
---

<div class="rounded-3xl border border-dashed border-line bg-surface px-6 py-14 text-center">
  <p class="text-4xl" aria-hidden="true">{emoji}</p>
  <p class="mt-4 text-lg font-bold">{title}</p>
  {text && <p class="mx-auto mt-2 max-w-md text-[0.95rem] leading-relaxed text-ink-3">{text}</p>}
  {actionHref && <a href={actionHref} class="btn mt-6">{actionLabel}</a>}
  <slot />
</div>
