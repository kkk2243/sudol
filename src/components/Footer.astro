---
import type { MenuItem, Settings } from '../lib/types';
import Logo from './Logo.astro';

interface Props {
  settings: Settings;
}
const { settings } = Astro.props;
const year = new Date().getFullYear();
const ext = (m: MenuItem) => (m.newTab || /^https?:/.test(m.href) ? { target: '_blank', rel: 'noopener noreferrer' } : {});
---

<footer class="mt-16 md:mt-24">
  <div class="wrap">
    <div class="grid gap-10 pb-10 md:grid-cols-[1.6fr_1fr_1fr] md:gap-8">
      <div>
        <a href="/" class="text-[1.6rem]" aria-label="홈으로"><Logo text={settings.logoText} /></a>
        <p class="mt-3 whitespace-pre-line text-[1.0625rem] font-medium leading-relaxed text-ink">{settings.footerSlogan}</p>
      </div>
      <nav aria-label="하단 메뉴">
        <ul class="space-y-2.5 text-[0.9375rem] font-medium">
          {
            settings.menuFooter.map((m) => (
              <li class="flex items-center gap-2.5">
                <span class="h-1 w-1 rounded-full bg-ink-3" aria-hidden="true" />
                <a href={m.href} class="hover:text-accent-ink" {...ext(m)}>
                  {m.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div>
        <ul class="space-y-2.5 text-[0.9375rem] font-medium">
          {
            settings.contactEmail && (
              <li class="flex items-center gap-2.5">
                <span class="h-1 w-1 rounded-full bg-ink-3" aria-hidden="true" />
                <a href={`mailto:${settings.contactEmail}`} class="break-all hover:text-accent-ink">
                  {settings.contactEmail}
                </a>
              </li>
            )
          }
          <li class="flex items-center gap-2.5">
            <span class="h-1 w-1 rounded-full bg-ink-3" aria-hidden="true"></span>
            <a href="/rss.xml" class="hover:text-accent-ink">RSS 구독</a>
          </li>
        </ul>
        <a href="/about" class="mt-6 inline-flex rounded-lg bg-soft px-5 py-3 text-sm font-semibold text-ink-2 hover:bg-ink hover:text-bg">
          {settings.authorName} 소개
        </a>
      </div>
    </div>

    <div class="flex flex-col gap-3 border-t border-ink/80 py-6 text-[0.8125rem] md:flex-row md:items-center md:justify-between dark:border-line">
      <p class="font-semibold">{settings.tagline}</p>
      <ul class="flex flex-wrap items-center gap-x-2 gap-y-1 text-ink-3">
        <li><a href="/privacy" class="font-bold text-ink hover:underline">개인정보처리방침</a></li>
        <li aria-hidden="true">·</li>
        <li><a href="/contact" class="hover:underline">연락처</a></li>
        <li aria-hidden="true">·</li>
        <li><a href="/admin" class="hover:underline" rel="nofollow">관리자</a></li>
      </ul>
      <p class="text-ink-3">© {year} {settings.authorName}. ALL RIGHTS RESERVED.</p>
    </div>
  </div>
</footer>
