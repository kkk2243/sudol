---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import PlaceCard from '../../components/PlaceCard.astro';
import Toc from '../../components/Toc.astro';
import AdSlot from '../../components/AdSlot.astro';
import PostGrid from '../../components/PostGrid.astro';
import AuthorBox from '../../components/AuthorBox.astro';
import { siteData } from '../../lib/site';
import { setPublicCache } from '../../lib/cache';
import { getPost, prevNext, relatedPosts } from '../../lib/content';
import { renderMarkdownServer } from '../../lib/markdown/server';
import { siteUrl } from '../../lib/env';
import { imgAttrs } from '../../lib/media';
import { formatDateKo } from '../../lib/util';

const site = await siteData(Astro.locals);
const slug = (Astro.params.slug ?? '').normalize('NFC');
const summary = site.published.find((p) => p.slug === slug);
if (!summary) return Astro.rewrite('/404');
const post = await getPost(summary.id);
if (!post) return Astro.rewrite('/404');
setPublicCache(Astro.response.headers, { index: site.index });

const { settings, categoryMap, published } = site;
const cat = categoryMap.get(post.category);
const rendered = renderMarkdownServer(post.body);
const showToc = rendered.toc.length >= 3;
const { prev, next } = prevNext(published, summary);
const related = relatedPosts(published, summary, 3);
const base = siteUrl(Astro.url);
const url = `${base}/post/${encodeURIComponent(post.slug)}`;
const hasPlace = !!(post.place && (post.place.name || post.place.address || post.place.mapUrl || post.place.rating));
const updated = post.updatedAt && new Date(post.updatedAt).getTime() - new Date(post.publishedAt).getTime() > 86400000;
const thumb = (src?: string) => (src ? imgAttrs(src, '96px') : null);

const abs = (u: string) => (/^https?:/.test(u) ? u : base + u);
const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.title.slice(0, 110),
    description: post.excerpt,
    image: post.cover?.src && !post.cover.src.endsWith('.svg') ? [abs(post.cover.src)] : undefined,
    datePublished: post.publishedAt,
    dateModified: post.updatedAt || post.publishedAt,
    author: { '@type': 'Person', name: settings.authorName, url: `${base}/about` },
    publisher: { '@type': 'Person', name: settings.authorName, url: base },
    mainEntityOfPage: { '@type': 'WebPage', '@id': url },
    inLanguage: 'ko-KR',
    articleSection: cat?.name,
    keywords: post.tags.join(', ') || undefined,
    wordCount: post.body.length,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '홈', item: base + '/' },
      ...(cat ? [{ '@type': 'ListItem', position: 2, name: cat.name, item: `${base}/category/${cat.slug}` }] : []),
      { '@type': 'ListItem', position: cat ? 3 : 2, name: post.title, item: url },
    ],
  },
];
---

<Base
  site={site}
  activePath={cat ? `/category/${cat.slug}` : '/posts'}
  seo={{
    title: `${post.title} | ${settings.title}`,
    description: post.excerpt,
    canonical: `/post/${encodeURIComponent(post.slug)}`,
    image: post.cover?.src,
    imageAlt: post.cover?.alt,
    type: 'article',
    publishedTime: post.publishedAt,
    modifiedTime: post.updatedAt,
    jsonLd,
  }}
>
  <article data-post-id={post.id} data-post-title={post.title}>
    <header class="wrap pt-12 md:pt-20">
      <div class="intro mx-auto max-w-[820px] text-center">
        <nav aria-label="현재 위치" class="flex items-center justify-center gap-2">
          <a href={cat ? `/category/${cat.slug}` : '/posts'} class="eyebrow transition-opacity hover:opacity-80">{cat ? cat.name : '전체 글'}</a>
          {post.sample && <span class="badge-sample">샘플</span>}
        </nav>
        <h1 class="mt-6 text-[1.95rem] font-bold leading-[1.3] tracking-[-0.04em] md:text-[3rem]">{post.title}</h1>
        {post.excerpt && <p class="mx-auto mt-5 max-w-2xl text-[1.0625rem] leading-relaxed text-ink-3">{post.excerpt}</p>}
        <p class="mt-6 flex flex-wrap items-center justify-center gap-x-2.5 gap-y-1 text-sm text-ink-3">
          <span class="font-semibold text-ink">{settings.authorName}</span>
          <span aria-hidden="true">·</span>
          <time datetime={post.publishedAt}>{formatDateKo(post.publishedAt)}</time>
          <span aria-hidden="true">·</span>
          <span>{summary.readingMinutes}분 읽기</span>
          {
            updated && (
              <>
                <span aria-hidden="true">·</span>
                <span>
                  수정 <time datetime={post.updatedAt}>{formatDateKo(post.updatedAt)}</time>
                </span>
              </>
            )
          }
        </p>
      </div>
      {
        post.cover?.src && (
          <figure class="mt-10 overflow-hidden rounded-[1.5rem] bg-soft md:mt-14 md:rounded-[2rem]">
            <Img src={post.cover.src} alt={post.cover.alt || ''} priority sizes="(min-width: 1080px) 1080px, 100vw" class="cover-zoom aspect-[16/9] w-full object-cover" />
          </figure>
        )
      }
    </header>

    <div class="wrap-wide mt-12 md:mt-16">
      <div class="grid grid-cols-1 gap-8 2xl:grid-cols-[minmax(0,1fr)_680px_minmax(0,1fr)]">
        <div class="hidden 2xl:block" aria-hidden="true"></div>
        <div class="mx-auto w-full max-w-[680px] min-w-0">
          {showToc && <Toc toc={rendered.toc} variant="inline" />}
          <AdSlot settings={settings} position="top" />

          <div class="prose" set:html={rendered.parts[0]} />
          {
            rendered.parts[1] && (
              <>
                <AdSlot settings={settings} position="middle" />
                <div class="prose mt-[1.4em]" set:html={rendered.parts[1]} />
              </>
            )
          }

          {hasPlace && <PlaceCard place={post.place!} />}

          {
            post.tags.length > 0 && (
              <ul class="mt-12 flex flex-wrap gap-2" aria-label="태그">
                {post.tags.map((t) => (
                  <li>
                    <a href={`/tag/${encodeURIComponent(t)}`} class="chip">
                      #{t}
                    </a>
                  </li>
                ))}
              </ul>
            )
          }

          <div class="mt-8 flex flex-wrap items-center gap-2">
            <button type="button" class="btn btn-sm btn-pill" data-copy-link={url}>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"></path><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"></path></svg>
              <span data-label>링크 복사</span>
            </button>
            <span class="sr-only" role="status" aria-live="polite" data-copy-status></span>
          </div>

          <AdSlot settings={settings} position="bottom" />

          <div class="mt-12">
            <AuthorBox settings={settings} />
          </div>

          {
            (prev || next) && (
              <nav aria-label="이전 글, 다음 글" class="mt-6 grid gap-3 sm:grid-cols-2">
                {[
                  { p: prev, label: '이전 글', right: false },
                  { p: next, label: '다음 글', right: true },
                ].map(({ p, label, right }) => {
                  if (!p) return <span class="hidden sm:block" />;
                  const t = thumb(p.cover?.src);
                  return (
                    <a href={`/post/${p.slug}`} class:list={['group flex items-center gap-4 rounded-[1.25rem] bg-soft p-3 pr-5 transition-colors hover:bg-soft-2', right && 'sm:flex-row-reverse sm:pl-5 sm:pr-3 sm:text-right']}>
                      <span class="h-16 w-16 shrink-0 overflow-hidden rounded-xl bg-soft-2">
                        {t && <img src={t.src} alt="" width="64" height="64" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-110" />}
                      </span>
                      <span class="min-w-0">
                        <span class="text-xs font-semibold text-ink-3">{right ? `${label} →` : `← ${label}`}</span>
                        <span class="line-clamp-2 mt-0.5 block font-semibold leading-snug">{p.title}</span>
                      </span>
                    </a>
                  );
                })}
              </nav>
            )
          }
        </div>

        <aside class="hidden 2xl:block" aria-label="사이드바">
          <div class="sticky top-28 max-w-[300px] space-y-8 pl-6">
            {showToc && <Toc toc={rendered.toc} variant="sidebar" />}
            <AdSlot settings={settings} position="sidebar" />
          </div>
        </aside>
      </div>
    </div>
  </article>

  {
    related.length > 0 && (
      <section aria-labelledby="related-title" class="wrap mt-24 md:mt-32">
        <div class="mb-8 flex items-end justify-between gap-4">
          <div>
            <p class="eyebrow">MORE</p>
            <h2 id="related-title" class="mt-4 text-[1.75rem] font-bold tracking-[-0.04em] md:text-[2.25rem]">
              이런 글은 어때요?
            </h2>
          </div>
          <a href={cat ? `/category/${cat.slug}` : '/posts'} class="hidden shrink-0 text-sm font-semibold text-ink-3 hover:text-ink sm:block">
            {cat ? `${cat.name} 더 보기` : '전체 글'} →
          </a>
        </div>
        <PostGrid posts={related} site={site} />
      </section>
    )
  }
</Base>

<script>
  // 링크 복사
  for (const b of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')) {
    b.addEventListener('click', async () => {
      const url = b.dataset.copyLink!;
      const label = b.querySelector('[data-label]')!;
      const status = document.querySelector('[data-copy-status]');
      let ok = false;
      try {
        await navigator.clipboard.writeText(url);
        ok = true;
      } catch {
        const ta = document.createElement('textarea');
        ta.value = url;
        document.body.appendChild(ta);
        ta.select();
        ok = document.execCommand('copy');
        ta.remove();
      }
      label.textContent = ok ? '복사했어요!' : '복사 실패';
      if (status) status.textContent = ok ? '링크를 복사했습니다.' : '링크를 복사하지 못했습니다.';
      setTimeout(() => (label.textContent = '링크 복사'), 2000);
    });
  }
  // 유튜브: 클릭했을 때만 iframe 로드(첫 화면 속도 보호)
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('.yt-link');
    if (!a) return;
    const box = a.closest<HTMLElement>('.yt');
    const id = box?.dataset.yt;
    if (!box || !id || !/^[A-Za-z0-9_-]{11}$/.test(id)) return;
    e.preventDefault();
    const f = document.createElement('iframe');
    f.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
    f.title = '유튜브 동영상';
    f.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
    f.allowFullscreen = true;
    f.referrerPolicy = 'strict-origin-when-cross-origin';
    box.replaceChildren(f);
    f.focus();
  });
</script>
