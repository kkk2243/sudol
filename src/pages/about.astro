---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { siteData } from '../lib/site';
import { setPublicCache } from '../lib/cache';
import { renderMarkdownServer } from '../lib/markdown/server';
import { siteUrl } from '../lib/env';

const site = await siteData(Astro.locals);
setPublicCache(Astro.response.headers, { index: site.index });
const { settings, categories, published } = site;
const body = renderMarkdownServer(settings.aboutBody).html;
const base = siteUrl(Astro.url);
const counts = categories.map((c) => ({ c, n: published.filter((p) => p.category === c.slug).length }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@type': 'Person', name: settings.authorName, description: settings.description, url: `${base}/about` },
};
---

<Base site={site} seo={{ title: `${settings.authorName} 소개 | ${settings.title}`, description: settings.description, canonical: '/about', jsonLd, image: settings.profileImage || null }}>
  <header class="wrap pb-12 pt-14 md:pt-24">
    <div class="grid items-center gap-10 md:grid-cols-[1fr_auto]">
      <div class="intro">
        <p class="eyebrow">ABOUT</p>
        <h1 class="mt-5 text-[2.25rem] font-bold leading-[1.2] tracking-[-0.04em] md:text-[3.5rem]">
          안녕하세요,<br />{settings.authorName}입니다
        </h1>
        <p class="mt-5 max-w-xl text-[1.0625rem] leading-relaxed text-ink-3">{settings.description}</p>
      </div>
      <div class="order-first h-40 w-40 overflow-hidden rounded-[2rem] bg-soft md:order-none md:h-64 md:w-64" data-reveal>
        {
          settings.profileImage ? (
            <Img src={settings.profileImage} alt={`${settings.authorName} 프로필 사진`} priority sizes="256px" class="h-full w-full object-cover" />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-orange-200 to-orange-500 text-7xl md:text-8xl" aria-hidden="true">🐻</div>
          )
        }
      </div>
    </div>

    <ul class="mt-12 grid grid-cols-3 gap-3 md:gap-4">
      {
        counts.map(({ c, n }, i) => (
          <li data-reveal style={`--d:${i * 90}ms`}>
            <a href={`/category/${c.slug}`} class="group block rounded-[1.25rem] bg-soft p-5 transition-colors hover:bg-ink hover:text-bg md:p-7">
              <span class="text-2xl md:text-3xl" aria-hidden="true">{c.emoji}</span>
              <span class="mt-3 block text-sm font-semibold text-ink-3 group-hover:text-bg/70">{c.name}</span>
              <span class="mt-0.5 block text-2xl font-black tracking-tight md:text-4xl">
                {n}<span class="ml-0.5 text-base font-semibold">편</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </header>

  <div class="wrap">
    <div class="prose max-w-[760px]" set:html={body} />
  </div>
</Base>
