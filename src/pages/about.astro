---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import { siteData } from '../lib/site';
import { setPublicCache } from '../lib/cache';
import { renderMarkdownServer } from '../lib/markdown/server';
import { siteUrl } from '../lib/env';

const site = await siteData(Astro.locals);
setPublicCache(Astro.response.headers, { index: site.index });
const { settings, categories, published } = site;
const body = renderMarkdownServer(settings.aboutBody).html;
const base = siteUrl(Astro.url);
const counts = categories.map((c) => ({ c, n: published.filter((p) => p.category === c.slug).length }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: { '@type': 'Person', name: settings.authorName, description: settings.description, url: `${base}/about` },
};
---

<Base site={site} seo={{ title: `${settings.authorName} 소개 | ${settings.title}`, description: settings.description, canonical: '/about', jsonLd, image: settings.profileImage || null }}>
  <div class="mx-auto max-w-[680px] px-5 pt-12 md:pt-20">
    <div class="flex flex-col items-center text-center">
      <div class="h-28 w-28 overflow-hidden rounded-full bg-accent-soft ring-4 ring-surface">
        {
          settings.profileImage ? (
            <Img src={settings.profileImage} alt={`${settings.authorName} 프로필 사진`} priority sizes="112px" class="h-full w-full object-cover" />
          ) : (
            <div class="flex h-full w-full items-center justify-center text-6xl" aria-hidden="true">🐻</div>
          )
        }
      </div>
      <p class="mt-5 text-sm font-bold text-accent-ink">ABOUT</p>
      <h1 class="mt-1 text-3xl font-extrabold tracking-tight md:text-4xl">{settings.authorName}</h1>
      <p class="mt-3 text-[1.0625rem] leading-relaxed text-ink-2">{settings.tagline}</p>
      <ul class="mt-6 flex flex-wrap justify-center gap-2">
        {
          counts.map(({ c, n }) => (
            <li>
              <a href={`/category/${c.slug}`} class="chip hover:bg-accent-soft hover:text-accent-ink">
                {c.emoji} {c.name} <span class="text-ink-3">{n}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <div class="prose mt-12" set:html={body} />
  </div>
</Base>
