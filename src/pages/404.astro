---
import Base from '../layouts/Base.astro';
import PostGrid from '../components/PostGrid.astro';
import { siteData } from '../lib/site';
import { setPublicCache } from '../lib/cache';

const site = await siteData(Astro.locals);
Astro.response.status = 404;
// 없는 주소는 짧게만 캐시(봇이 무작위 주소를 두드려도 함수 호출이 폭증하지 않도록)
setPublicCache(Astro.response.headers, { index: site.index, maxSeconds: 3600 });
const recent = site.published.slice(0, 3);
---

<Base site={site} banner={false} seo={{ title: `페이지를 찾을 수 없어요 | ${site.settings.title}`, description: '요청하신 페이지가 없거나 주소가 바뀌었어요.', noindex: true }}>
  <div class="wrap pt-16 md:pt-28">
    <div class="intro">
      <p class="eyebrow">404</p>
      <h1 class="mt-5 text-[2.25rem] font-bold leading-[1.25] tracking-[-0.04em] md:text-[3.25rem]">앗, 그 페이지는<br />찾을 수 없어요</h1>
      <p class="mt-4 max-w-md text-ink-3">주소가 바뀌었거나 삭제된 글일 수 있어요. 검색하거나 최근 글을 둘러보세요.</p>
      <div class="mt-8 flex flex-wrap gap-2">
        <a href="/" class="btn btn-primary btn-pill">홈으로</a>
        <a href="/search" class="btn btn-pill">검색하기</a>
      </div>
    </div>
  </div>
  {
    recent.length > 0 && (
      <section aria-labelledby="recent-404" class="wrap mt-20">
        <h2 id="recent-404" class="mb-8 text-2xl font-bold tracking-tight">
          최근 글
        </h2>
        <PostGrid posts={recent} site={site} />
      </section>
    )
  }
</Base>
