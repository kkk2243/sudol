---
import Base from '../layouts/Base.astro';
import ListHeader from '../components/ListHeader.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import PostGrid from '../components/PostGrid.astro';
import TagMarquee from '../components/TagMarquee.astro';
import EmptyState from '../components/EmptyState.astro';
import { PAGE_SIZE, siteData } from '../lib/site';
import { setPublicCache } from '../lib/cache';
import { siteUrl } from '../lib/env';

const site = await siteData(Astro.locals);
setPublicCache(Astro.response.headers, { index: site.index });
const { settings, published, categories } = site;
const latest = published.slice(0, PAGE_SIZE);
const base = siteUrl(Astro.url);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: settings.title,
  url: base,
  description: settings.description,
  inLanguage: 'ko-KR',
  author: { '@type': 'Person', name: settings.authorName, url: `${base}/about` },
  potentialAction: {
    '@type': 'SearchAction',
    target: `${base}/search?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<Base site={site} seo={{ title: settings.title, description: settings.description, canonical: '/', jsonLd, image: latest.find((p) => p.cover)?.cover?.src }}>
  <ListHeader eyebrow={settings.heroLabel} title={settings.heroTitle} description={settings.heroSubtitle}>
    <CategoryFilter categories={categories} active="all" allHref="/" />
  </ListHeader>

  <section class="wrap" aria-labelledby="latest-title">
    <h2 id="latest-title" class="sr-only">최신 글</h2>
    {
      latest.length ? (
        <PostGrid posts={latest} site={site} eager />
      ) : (
        <EmptyState emoji="🍳" title="첫 글을 기다리고 있어요" text="관리자 화면에서 첫 번째 맛집·일상·여행 이야기를 올려보세요." actionHref="/admin/posts/new" actionLabel="첫 글 쓰기" />
      )
    }
    {
      published.length > PAGE_SIZE && (
        <div class="mt-14 text-center">
          <a href="/posts?page=2" class="btn btn-primary btn-pill px-7">
            더 많은 글 보기 <span aria-hidden="true">→</span>
          </a>
        </div>
      )
    }
  </section>

  <TagMarquee posts={published} />
</Base>
