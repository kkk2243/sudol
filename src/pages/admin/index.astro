---
import Admin from '../../layouts/Admin.astro';
import { getCategories, getIndex, isLive } from '../../lib/content';
import { imgAttrs } from '../../lib/media';
import { formatDateTimeKo } from '../../lib/util';

const [index, categories] = await Promise.all([getIndex(), getCategories()]);
const catMap = new Map(categories.map((c) => [c.slug, c]));
const sp = Astro.url.searchParams;
const q = (sp.get('q') || '').trim().toLowerCase();
const status = sp.get('status') || 'all';
const cat = sp.get('category') || '';
const sort = sp.get('sort') || 'newest';
const now = Date.now();

const stateOf = (p: (typeof index)[number]) =>
  p.status === 'draft' ? 'draft' : isLive(p, now) ? 'published' : 'scheduled';

let list = index.filter((p) => {
  if (status !== 'all' && stateOf(p) !== status) return false;
  if (cat && p.category !== cat) return false;
  if (q && !(p.title + ' ' + p.tags.join(' ') + ' ' + (p.placeName || '')).toLowerCase().includes(q)) return false;
  return true;
});
list = [...list].sort((a, b) =>
  sort === 'oldest'
    ? a.publishedAt.localeCompare(b.publishedAt)
    : sort === 'updated'
      ? b.updatedAt.localeCompare(a.updatedAt)
      : sort === 'title'
        ? a.title.localeCompare(b.title, 'ko')
        : b.publishedAt.localeCompare(a.publishedAt),
);
const counts = {
  all: index.length,
  published: index.filter((p) => stateOf(p) === 'published').length,
  scheduled: index.filter((p) => stateOf(p) === 'scheduled').length,
  draft: index.filter((p) => stateOf(p) === 'draft').length,
};
const sampleCount = index.filter((p) => p.sample).length;
const label = { published: '발행됨', scheduled: '예약', draft: '임시저장' } as const;
---

<Admin title="글 목록" active="posts">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-extrabold">글 목록</h1>
    <a href="/admin/posts/new" class="btn btn-primary">✏️ 새 글 쓰기</a>
  </div>

  {
    sampleCount > 0 && (
      <div class="card mt-5 flex flex-wrap items-center gap-3 border-amber-300 bg-amber-50 p-4 text-sm text-amber-950 dark:bg-amber-950/40 dark:text-amber-100" role="note">
        <p class="flex-1">
          <span class="badge-sample">샘플</span> 표시된 글이 <strong>{sampleCount}개</strong> 있어요. 애드센스 신청 전에 꼭 삭제하세요.
        </p>
        <button type="button" class="btn btn-sm btn-danger" data-delete-samples>
          샘플 글 모두 삭제
        </button>
      </div>
    )
  }

  <form method="get" class="card mt-5 grid gap-3 p-4 sm:grid-cols-2 lg:grid-cols-[1fr_auto_auto_auto_auto]" role="search">
    <label class="sr-only" for="f-q">제목·태그·장소 검색</label>
    <input id="f-q" class="input" type="search" name="q" value={sp.get('q') || ''} placeholder="제목, 태그, 장소로 검색" />
    <label class="sr-only" for="f-status">상태</label>
    <select id="f-status" name="status" class="select">
      <option value="all" selected={status === 'all'}>전체 상태 ({counts.all})</option>
      <option value="published" selected={status === 'published'}>발행됨 ({counts.published})</option>
      <option value="scheduled" selected={status === 'scheduled'}>예약 ({counts.scheduled})</option>
      <option value="draft" selected={status === 'draft'}>임시저장 ({counts.draft})</option>
    </select>
    <label class="sr-only" for="f-cat">카테고리</label>
    <select id="f-cat" name="category" class="select">
      <option value="">모든 카테고리</option>
      {categories.map((c) => <option value={c.slug} selected={cat === c.slug}>{c.emoji} {c.name}</option>)}
    </select>
    <label class="sr-only" for="f-sort">정렬</label>
    <select id="f-sort" name="sort" class="select">
      <option value="newest" selected={sort === 'newest'}>발행일 최신순</option>
      <option value="oldest" selected={sort === 'oldest'}>발행일 오래된순</option>
      <option value="updated" selected={sort === 'updated'}>최근 수정순</option>
      <option value="title" selected={sort === 'title'}>제목순</option>
    </select>
    <button class="btn">적용</button>
  </form>

  {
    list.length === 0 ? (
      <div class="mt-8 rounded-2xl border border-dashed border-line px-6 py-14 text-center">
        <p class="text-4xl" aria-hidden="true">📭</p>
        <p class="mt-3 font-bold">{index.length === 0 ? '아직 쓴 글이 없어요' : '조건에 맞는 글이 없어요'}</p>
        {index.length === 0 ? (
          <a class="btn btn-primary mt-5" href="/admin/posts/new">
            첫 글 쓰기
          </a>
        ) : (
          <a class="btn mt-5" href="/admin">
            필터 초기화
          </a>
        )}
      </div>
    ) : (
      <ul class="card mt-5 divide-y divide-line" data-post-list>
        {list.map((p) => {
          const st = stateOf(p);
          const thumb = p.cover?.src ? imgAttrs(p.cover.src) : null;
          const thumbSrc = thumb?.srcset ? thumb.srcset.split(', ')[0].split(' ')[0] : thumb?.src;
          return (
            <li class="flex items-center gap-3 p-3 sm:p-4" data-row={p.id}>
              {thumbSrc ? <img src={thumbSrc} alt="" class="thumb" loading="lazy" width="64" height="48" /> : <div class="thumb flex items-center justify-center text-xl" aria-hidden="true">{catMap.get(p.category)?.emoji ?? '📝'}</div>}
              <div class="min-w-0 flex-1">
                <p class="flex flex-wrap items-center gap-1.5 text-xs">
                  <span class={`status-badge status-${st}`}>{label[st]}</span>
                  {p.sample && <span class="badge-sample">샘플</span>}
                  <span class="text-ink-3">{catMap.get(p.category)?.name ?? p.category}</span>
                </p>
                <a href={`/admin/posts/${p.id}`} class="mt-1 block truncate font-semibold hover:underline">
                  {p.title}
                </a>
                <p class="mt-0.5 text-xs text-ink-3">
                  {st === 'scheduled' ? '예약 ' : ''}
                  {formatDateTimeKo(p.publishedAt)} · 수정 {formatDateTimeKo(p.updatedAt)}
                </p>
              </div>
              <div class="flex shrink-0 flex-col gap-1 sm:flex-row">
                {st === 'published' && (
                  <a class="btn btn-sm" href={`/post/${p.slug}`} target="_blank" rel="noopener">
                    보기
                  </a>
                )}
                <a class="btn btn-sm" href={`/admin/posts/${p.id}`}>
                  수정
                </a>
                <button type="button" class="btn btn-sm btn-danger" data-delete={p.id} data-title={p.title}>
                  삭제
                </button>
              </div>
            </li>
          );
        })}
      </ul>
    )
  }
</Admin>

<script>
  import { api, confirmDialog, errMsg, toast, withBusy } from '../../admin/client';

  document.querySelectorAll<HTMLButtonElement>('[data-delete]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const ok = await confirmDialog(`'${btn.dataset.title}' 글을 삭제할까요? 삭제한 글은 되돌릴 수 없어요.`, {
        title: '글 삭제',
        okLabel: '삭제',
        danger: true,
      });
      if (!ok) return;
      await withBusy(btn, '삭제 중', async () => {
        try {
          await api(`/api/admin/posts/${btn.dataset.delete}`, { method: 'DELETE' });
          document.querySelector(`[data-row="${btn.dataset.delete}"]`)?.remove();
          toast('삭제했어요.');
          if (!document.querySelector('[data-row]')) location.reload();
        } catch (e) {
          toast(errMsg(e), true);
        }
      });
    }),
  );

  document.querySelector<HTMLButtonElement>('[data-delete-samples]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const ok = await confirmDialog('샘플 표시가 붙은 글을 모두 삭제할까요? (내가 쓴 글은 지워지지 않아요)', {
      title: '샘플 글 삭제',
      okLabel: '모두 삭제',
      danger: true,
    });
    if (!ok) return;
    await withBusy(btn, '삭제 중', async () => {
      try {
        const r = await api<{ deleted: number }>('/api/admin/samples', { method: 'DELETE' });
        location.href = `/admin?msg=${encodeURIComponent(`샘플 글 ${r.deleted}개를 삭제했어요.`)}`;
      } catch (err) {
        toast(errMsg(err), true);
      }
    });
  });
</script>
