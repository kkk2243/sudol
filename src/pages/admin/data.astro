---
import Admin from '../../layouts/Admin.astro';
import { getIndex } from '../../lib/content';

const index = await getIndex();
const samples = index.filter((p) => p.sample).length;
---

<Admin title="데이터 관리" active="data">
  <h1 class="text-2xl font-extrabold">데이터 관리</h1>
  <p id="progress" class="mt-2 min-h-[1.5rem] text-sm font-semibold text-accent-ink" role="status" aria-live="polite"></p>

  <section class="card mt-4 space-y-3 p-5">
    <h2 class="text-lg font-bold">💾 내보내기 (백업)</h2>
    <p class="text-sm text-ink-3">다른 호스팅으로 옮기거나 정기 백업할 때 쓰세요. 이미지가 많으면 시간이 걸려요.</p>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn" data-export="json">JSON 백업 (이미지 포함)</button>
      <button type="button" class="btn" data-export="json-lite">JSON 백업 (글만)</button>
      <button type="button" class="btn" data-export="md">마크다운 zip (이미지 포함)</button>
    </div>
  </section>

  <section class="card mt-4 space-y-3 p-5">
    <h2 class="text-lg font-bold">📥 가져오기 (복원)</h2>
    <p class="text-sm text-ink-3">
      이 블로그에서 내보낸 .json 또는 .zip 파일을 올리세요. 같은 글(id)은 덮어쓰고, 없는 글은 새로 추가돼요. 블로그 설정·카테고리도 백업 내용으로 바뀌어요.
    </p>
    <label class="field">
      <span class="sr-only">백업 파일 선택</span>
      <input type="file" id="import-file" accept=".json,.zip,application/json,application/zip" class="input" />
    </label>
    <button type="button" class="btn btn-primary" data-import>가져오기 시작</button>
  </section>

  <section class="card mt-4 space-y-3 p-5">
    <h2 class="text-lg font-bold">🧹 정리</h2>
    <div class="flex flex-wrap items-center gap-3">
      <p class="flex-1 text-sm">샘플 글 <strong>{samples}개</strong> — 애드센스 신청 전에 반드시 지우세요.</p>
      <button type="button" class="btn btn-danger" data-delete-samples disabled={samples === 0}>샘플 글 모두 삭제</button>
    </div>
    <div class="flex flex-wrap items-center gap-3 border-t border-line pt-3">
      <p class="flex-1 text-sm">어느 글에서도 쓰지 않는 이미지를 찾아 저장 공간을 비워요.</p>
      <button type="button" class="btn" data-find-unused>안 쓰는 이미지 찾기</button>
    </div>
  </section>
</Admin>

<script>
  import { api, confirmDialog, errMsg, toast, withBusy } from '../../admin/client';
  import { exportJson, exportMarkdownZip, importFile } from '../../admin/backup';

  const progressEl = document.getElementById('progress')!;
  const progress = (m: string) => (progressEl.textContent = m);
  let busy = false;
  window.addEventListener('beforeunload', (e) => {
    if (busy) e.preventDefault();
  });

  document.querySelectorAll<HTMLButtonElement>('[data-export]').forEach((b) =>
    b.addEventListener('click', () =>
      withBusy(b, '준비 중', async () => {
        busy = true;
        try {
          const t = b.dataset.export;
          if (t === 'md') await exportMarkdownZip(progress);
          else await exportJson(t === 'json', progress);
          toast('백업 파일을 내려받았어요.');
        } catch (e) {
          progress('');
          toast(errMsg(e), true, 6000);
        } finally {
          busy = false;
        }
      }),
    ),
  );

  document.querySelector<HTMLButtonElement>('[data-import]')!.addEventListener('click', async (e) => {
    const file = (document.getElementById('import-file') as HTMLInputElement).files?.[0];
    if (!file) return toast('먼저 백업 파일을 선택해 주세요.', true);
    const ok = await confirmDialog(`'${file.name}'을(를) 가져올까요? 같은 글과 블로그 설정은 백업 내용으로 덮어써요.`, { title: '가져오기', okLabel: '가져오기' });
    if (!ok) return;
    await withBusy(e.currentTarget as HTMLButtonElement, '가져오는 중', async () => {
      busy = true;
      try {
        const msg = await importFile(file, progress);
        progress(msg);
        toast(msg, false, 6000);
      } catch (err) {
        progress('');
        toast(errMsg(err), true, 6000);
      } finally {
        busy = false;
      }
    });
  });

  document.querySelector<HTMLButtonElement>('[data-delete-samples]')!.addEventListener('click', async (e) => {
    if (!(await confirmDialog('샘플 표시가 붙은 글을 모두 삭제할까요?', { title: '샘플 글 삭제', okLabel: '모두 삭제', danger: true }))) return;
    const btn = e.currentTarget as HTMLButtonElement;
    await withBusy(btn, '삭제 중', async () => {
      try {
        const r = await api<{ deleted: number }>('/api/admin/samples', { method: 'DELETE' });
        location.href = '/admin/data?msg=' + encodeURIComponent(`샘플 글 ${r.deleted}개를 삭제했어요.`);
      } catch (err) {
        toast(errMsg(err), true);
      }
    });
  });

  document.querySelector<HTMLButtonElement>('[data-find-unused]')!.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    await withBusy(btn, '찾는 중', async () => {
      try {
        const r = await api<{ unused: string[] }>('/api/admin/media');
        if (!r.unused.length) return toast('정리할 이미지가 없어요. 👍');
        const ok = await confirmDialog(`쓰지 않는 이미지 파일 ${r.unused.length}개를 찾았어요(축소본 포함). 삭제할까요? 임시저장 글에도 안 쓰인 파일만 지워요.`, {
          title: '이미지 정리',
          okLabel: '삭제',
          danger: true,
        });
        if (!ok) return;
        const d = await api<{ deleted: number }>('/api/admin/media', { method: 'POST', json: { keys: r.unused } });
        toast(`이미지 ${d.deleted}개를 삭제했어요.`);
      } catch (err) {
        toast(errMsg(err), true);
      }
    });
  });
</script>
