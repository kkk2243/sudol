---
import Base from '../layouts/Base.astro';
import ListHeader from '../components/ListHeader.astro';
import { siteData } from '../lib/site';
import { setPublicCache } from '../lib/cache';

const site = await siteData(Astro.locals);
setPublicCache(Astro.response.headers, { index: site.index });
const { settings } = site;
const email = settings.contactEmail;
---

<Base site={site} banner={false} seo={{ title: `연락처 | ${settings.title}`, description: `${settings.authorName}에게 문의·제안하는 방법`, canonical: '/contact' }}>
  <ListHeader eyebrow="CONTACT" title={'궁금한 점이나 제안은\n편하게 보내주세요'} description="블로그 글에 대한 의견, 잘못된 정보 제보, 협업 제안 모두 환영해요. 보통 2~3일 안에 답장드립니다." />
  <div class="wrap">
    {
      email ? (
        <a href={`mailto:${email}`} class="group block rounded-[1.75rem] bg-ink p-8 text-bg transition-transform hover:-translate-y-1 md:p-12" data-reveal>
          <p class="text-sm font-semibold opacity-60">EMAIL</p>
          <p class="mt-3 break-all text-[1.6rem] font-bold tracking-[-0.03em] md:text-[2.75rem]">{email}</p>
          <p class="mt-8 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-3 text-sm font-bold text-[#111]">
            메일 보내기 <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
          </p>
        </a>
      ) : (
        <div class="rounded-[1.75rem] bg-soft p-8 text-ink-3">연락 이메일이 아직 등록되지 않았어요.</div>
      )
    }
    <div class="prose mt-14 max-w-[760px]">
      <h2>안내</h2>
      <ul>
        <li>협찬·광고 제안을 받더라도 직접 경험한 내용만 솔직하게 쓰며, 협찬 글은 반드시 표시합니다.</li>
        <li>가게 정보(가격, 영업시간)가 바뀌었다면 알려주세요. 확인 후 글을 고치겠습니다.</li>
        <li>개인정보 처리에 대한 문의는 <a href="/privacy">개인정보처리방침</a>을 참고해 주세요.</li>
      </ul>
    </div>
  </div>
</Base>
