---
// 서버 오류 페이지: 저장소 장애 등으로 데이터를 못 읽어도 보여야 하므로 외부 데이터를 쓰지 않습니다.
import '../styles/global.css';
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Netlify-CDN-Cache-Control', 'no-store');
---

